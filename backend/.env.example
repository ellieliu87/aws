# Copy to backend/.env and fill in. Restart the backend after editing.
#
# The agents always construct AsyncOpenAI() with NO arguments — the SDK
# auto-resolves the endpoint + auth from these standard env vars. Inside
# Capital One's COF proxy environment, none of these need to be set: the
# corporate openai SDK fork preconfigures the proxy transparently.
#
# Outside the corporate environment, set:
#   OPENAI_API_KEY  — your direct-OpenAI key (sk-...)
# Optionally set:
#   OPENAI_BASE_URL — alternate endpoint (e.g. an internal gateway)
#
OPENAI_API_KEY=
# OPENAI_BASE_URL=

# ── or keep the key out of this file entirely ────────────────────────
# Set CMA_SECRETS_PREFIX and the backend reads its provider credentials
# from SSM Parameter Store at boot instead, before anything imports them.
# The last path segment becomes the variable name, so
# `/cma/workbench/OPENAI_API_KEY` arrives as OPENAI_API_KEY and nothing
# downstream changes.
#
#   python -m infra.put_secret OPENAI_API_KEY --write
#   (then delete the OPENAI_API_KEY line above and restart)
#
# Precedence: a variable already exported in the real environment always
# wins; everything else, this file included, loses to Parameter Store.
# Unset, none of this happens and the key is read from the line above.
# CMA_SECRETS_PREFIX=/cma/workbench

# Optional: override which model the tool/analytics drafter uses
# (skill .md files each declare their own model; this only affects the
# direct-OpenAI drafter endpoints in routers/tools.py + analytics_defs.py).
# CMA_TOOL_DRAFT_MODEL=gpt-oss-120b


# ─────────────────────────────────────────────────────────────────────
# AWS — all optional. With none of these set the app runs entirely
# in-process: local disk for files, module dicts for state, mock login,
# solves computed inline. See docs/ARCHITECTURE.md.
# ─────────────────────────────────────────────────────────────────────

# ── Set by hand, before the first deploy ─────────────────────────────

# The one required input to the CDK stack. Job results, model artifacts,
# datasets, the build zip and the document corpus all live here, under
# separate prefixes.
# CMA_CORPUS_BUCKET=

# Region for the stack and every client. Falls back to CMA_BEDROCK_REGION,
# then AWS_REGION, then us-east-1.
# CMA_JOBS_REGION=us-east-1

# Where CloudWatch alarms and the cost budget report.
#
# Leave it unset and the deploy still works: the five alarms are created and
# still fire, they just have no subscriber (subscribe the AlertsTopicArn by
# hand later), and the budget is skipped because a budget nobody hears from
# is decoration.
#
# Set it and CONFIRM THE SUBSCRIPTION EMAIL that SNS sends. An unconfirmed
# subscription silently drops every notification, which is worse than no
# alarm at all — it looks like everything is fine.
# CMA_ALARM_EMAIL=

# Monthly cost budget in USD; notifies at 80% actual and 100% forecast.
# Defaults to 5 when unset — this stack is sized to sit inside the free
# tier, so five dollars means something changed. Set to 0 to opt out.
# CMA_MONTHLY_BUDGET_USD=5

# How many days an analytics run stays on the history page before
# DynamoDB's TTL sweeps it. Defaults to 90.
#
# The judgement behind the default: a run is scratch, not a record. The
# dataset, the model, the saved workflow and the compiled plan versions in
# S3 are all kept indefinitely, so a number stays reproducible after the
# run row that first reported it is gone.
#
# Set to 0 to keep runs forever — the right setting the day the run history
# itself has to answer "what did we file, and when".
#
# Only affects runs written from here on; items already in the table carry
# no expiry and are never touched.
# CMA_RUN_TTL_DAYS=90

# How often a node reconciles agent/skills_user/ against S3, in seconds.
# Defaults to 30.
#
# This is the staleness window, and it exists because skills are read by
# globbing a directory rather than by id: there is no "miss" to detect, so the
# whole prefix has to be listed. Doing that on every chat turn would put S3 in
# the middle of every message.
#
# The node that served an upload writes through immediately, so it never sees
# its own edit late — the window only applies to the *other* replicas. Lower it
# if uploads must propagate faster; raise it to cut LIST calls.
# CMA_SKILLS_SYNC_SECONDS=30

# Switches the Lambda worker from the zip build (goal-seek arithmetic only)
# to the container image (real .pkl / .joblib artifacts). Set only after
# `python -m infra.build_worker_image` has pushed an image — it prints the
# tag. Equivalent to `npx cdk deploy -c workerImageTag=<tag>`.
# CMA_WORKER_IMAGE_TAG=

# ── Written for you by `python -m infra.sync_env --write` ────────────
# CDK names physical resources itself, so these are not knowable until
# after a deploy. Do not hand-edit; re-run the sync instead.
#
#   CMA_JOBS_QUEUE_URL          async solve queue
#   CMA_PLAYBOOK_STATE_MACHINE  playbook state machine
#   CMA_SOLVER_FUNCTION_ARN     worker Lambda, invoked by compiled canvases
#   CMA_PLAYBOOK_ROLE_ARN       role those canvases' state machines assume
#   CMA_STATE_TABLE             DynamoDB single table
#   CMA_COGNITO_USER_POOL_ID    set this and the mock login is replaced
#   CMA_COGNITO_CLIENT_ID       app client for USER_PASSWORD_AUTH
